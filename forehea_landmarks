import json

def cook(scriptOp):
    scriptOp.clear()
    
    dat = op('null_face')  # cambia por tu nombre real
    
    points = {
        # Superior
        'forehead_top_right':  103,
        'forehead_top_left':   332,
        # Centro superior
        'forehead_top':         10,
        # Medio
        'forehead_mid_right':   67,
        'forehead_mid_left':   297,
        # Medio bajo
        'forehead_low_right':  109,
        'forehead_low_left':   338,
        # Lateral
        'forehead_side_right': 234,
        'forehead_side_left':  454,
    }
    
    try:
        data = json.loads(dat[0, 0].val)
        landmarks = data["faceLandmarkResults"]["faceLandmarks"][0]
        
        for name, idx in points.items():
            point = landmarks[idx]
            scriptOp.appendChan(f'{name}_x').vals = [point['x']]
            scriptOp.appendChan(f'{name}_y').vals = [point['y']]
            scriptOp.appendChan(f'{name}_z').vals = [point['z']]
        
    except Exception as e:
        print("ERROR:", e)
        for name in points.keys():
            for axis in ['x', 'y', 'z']:
                scriptOp.appendChan(f'{name}_{axis}').vals = [0]
